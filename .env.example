# Compose needs none of these; its local-only defaults work out of the box.
# For running Python directly, set these in your shell (or load with your editor).
DATABASE_URL=postgresql://wallet:local-postgres-development-only@localhost:5432/wallet
ADMIN_TOKEN=replace-with-at-least-32-random-characters
ENABLE_FIXTURES=true
PUBLIC_LOGS=true
PORT=8000
